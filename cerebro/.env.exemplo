# Copie para .env e preencha. Nunca suba o .env para o GitHub.
CEREBRO_SEGREDO=troque-por-uma-frase-longa-e-aleatoria
# 1 quando o acesso for por https (Cloudflare). Deixe 0 para testar em http na rede local.
CEREBRO_COOKIE_SEGURO=1
# Token do túnel da Cloudflare (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
