# Token do túnel da Cloudflare (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# Shopify: app personalizado com permissão read_orders (Configurações > Apps > Desenvolver apps)
SHOPIFY_LOJA=roccokids.myshopify.com
SHOPIFY_TOKEN=
